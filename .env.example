# ==========================================
# Configurações do Portal de Monitoramento
# ==========================================
SITE_BASE_URL="https://portal-monitoramento.exemplo.com.br"
SITE_LOGIN_URL="https://portal-monitoramento.exemplo.com.br/login"
SITE_FLOWS_URL="https://portal-monitoramento.exemplo.com.br/fluxos"
SITE_USERNAME="seu_usuario_aqui"
SITE_PASSWORD="sua_senha_aqui"

# ==========================================
# Seletores CSS do Portal (Customizáveis)
# ==========================================
# Seletor do input de usuário e senha na tela de login
SELECTOR_USERNAME_INPUT="input[name='username'], input[type='email'], #usuario, #login"
SELECTOR_PASSWORD_INPUT="input[name='password'], input[type='password'], #senha"
SELECTOR_LOGIN_BUTTON="button[type='submit'], #btn-login, input[type='submit']"

# Seletor do dropdown/filtro de equipamentos
SELECTOR_EQUIPMENT_FILTER="select[name='equipamento'], select#filtro-radar, .select-equipamento"

# Seletor da tabela de faixas e linhas de dados
SELECTOR_LANES_TABLE="table.tabela-fluxos, #grid-faixas, table"
SELECTOR_LANE_ROWS="tbody tr, tr.linha-faixa"

# Lista de equipamentos específicos a verificar (separados por vírgula)
# Deixe vazio para detectar todos automaticamente no select do portal
EQUIPMENT_LIST="SPK347-1,SPK347-2,SPK348-1,SPK348-2,SPK351-1,SPK351-2,SPK352-1,SPK352-2"

# ==========================================
# Configurações do Google Sheets
# ==========================================
# ID da planilha (encontrado na URL da planilha do Google)
# Ex: https://docs.google.com/spreadsheets/d/[ESTE_ID_AQUI]/edit
GOOGLE_SHEET_ID="1a2b3c4d5e6f7g8h9i0j_exemplo_id"

# Caminho local do arquivo de credenciais da Conta de Serviço (para testes no seu PC)
GOOGLE_SERVICE_ACCOUNT_FILE="service_account.json"

# Conteúdo bruto do JSON da Conta de Serviço (usado no GitHub Actions Secrets)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Nomes das abas da planilha
SHEET_TAB_HISTORY="Historico_Geral"
SHEET_TAB_PENDING="Pendencias_Tecnicas"

# Resiliência no Google Sheets (Exponential Backoff)
SHEETS_MAX_RETRIES="4"
SHEETS_BACKOFF_BASE_SECONDS="1.5"

# ==========================================
# Notificações de Alerta (Opcionais)
# ==========================================
# Opção A: Webhook (Discord, Slack, Microsoft Teams)
# ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Opção B: Bot do Telegram
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="-1001234567890"

# Opção C: Notificação por E-mail (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu_email@gmail.com"
# SMTP_PASSWORD="sua_senha_de_app"
# SMTP_USE_TLS="True"
# ALERT_EMAILS_TO="tecnico1@empresa.com.br,tecnico2@empresa.com.br"

# ==========================================
# Configurações de Execução
# ==========================================
# Executar o navegador em segundo plano (True para GitHub Actions / Produção)
HEADLESS="True"

# Tempo máximo de espera por página em milissegundos
BROWSER_TIMEOUT_MS="30000"

# Tempo de espera inicial (em segundos) para carregar o mapa após o login (ex: 10)
INITIAL_PAGE_WAIT_SECONDS="10"

# Interceptação de Rede rápida para payloads JSON (True/False)
ENABLE_NETWORK_INTERCEPTION="True"

# Modo de simulação para testar sem acessar o portal real (True/False)
MOCK_MODE="False"
